{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://promptcase-studio.local/schemas/test_case_response-4.0.0.json",
  "title": "Promptcase Studio Unit Test Response",
  "description": "사람이 작성한 형태의 한국어 단위테스트 문안 계약",
  "type": "object",
  "additionalProperties": false,
  "required": ["testCase", "testResult"],
  "properties": {
    "documentTitle": {
      "description": "확장자와 날짜를 제외한 짧은 시스템명이며 기존 응답 호환을 위해 선택 필드로 유지한다",
      "type": "string",
      "maxLength": 40,
      "pattern": "^(?!.$)(?!.*(?:단위\\s*테스트|[.]xlsx|(?:19|20)[0-9]{2}[-_.]?[0-9]{2}[-_.]?[0-9]{2}|[0-9]{6,8}))(?!.*[()（）])(?!.*[.,!?;:。，！？]$)[^\\r\\n\\u005c:;：；·ㆍ‧∙⋅○●•◦▪▫◆◇▶▷■□※★☆♥♡♠♣\\\"'“”‘’「」『』＂＇`*#><\\[\\]{}|~]*$"
    },
    "testCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "scenarios",
        "targetIds",
        "targetNames",
        "preconditions",
        "notes"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 6,
          "maxLength": 100,
          "pattern": "^(?!\\s*(?:[-*#]|[0-9]+[.)]))(?=[^\\r\\n]*단위테스트$)[^\\r\\n\\u005c:;：；·ㆍ‧∙⋅○●•◦▪▫◆◇▶▷■□※★☆♥♡♠♣\\\"'“”‘’「」『』＂＇`*#><\\[\\]{}|~]+$"
        },
        "scenarios": {
          "description": "입력 조건, 실행, 예상결과와 판정 기준이 한 객체에서 대응하는 근거 기반 독립 테스트 시나리오",
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "contains": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": {
                "const": "success"
              }
            }
          },
          "minContains": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "title",
              "procedure",
              "testData",
              "expectedResult",
              "evidenceRefs"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "success",
                  "validation",
                  "boundary",
                  "permission",
                  "error",
                  "regression"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 3,
                "maxLength": 60,
                "pattern": "^(?!\\s*(?:[-*#]|[0-9]+[.)]))(?!.*[.,!?;:。，！？]$)[^\\r\\n\\u005c:;：；·ㆍ‧∙⋅○●•◦▪▫◆◇▶▷■□※★☆♥♡♠♣\\\"'“”‘’「」『』＂＇`*#><\\[\\]{}|~]+$"
              },
              "procedure": {
                "type": "string",
                "minLength": 10,
                "maxLength": 240,
                "pattern": "^(?!\\s*(?:[-*#]|[0-9]+[.)]))(?=[^\\r\\n]*다$)[^\\r\\n\\u005c:;：；·ㆍ‧∙⋅○●•◦▪▫◆◇▶▷■□※★☆♥♡♠♣\\\"'“”‘’「」『』＂＇`*#><\\[\\]{}|~]+$"
              },
              "testData": {
                "description": "선택된 근거에 실제 등장하는 값 또는 값이 없을 때의 근거 기반 조건이며 별도 데이터가 없으면 빈 문자열",
                "type": "string",
                "minLength": 0,
                "maxLength": 240,
                "pattern": "^(?:$|(?!\\s*(?:[-*#]|[0-9]+[.)]))[^\\r\\n\\u005c:;：；·ㆍ‧∙⋅○●•◦▪▫◆◇▶▷■□※★☆♥♡♠♣\\\"'“”‘’「」『』＂＇`*#><\\[\\]{}|~]+)$"
              },
              "expectedResult": {
                "type": "string",
                "minLength": 10,
                "maxLength": 240,
                "pattern": "^(?!\\s*(?:[-*#]|[0-9]+[.)]))(?=[^\\r\\n]*다$)[^\\r\\n\\u005c:;：；·ㆍ‧∙⋅○●•◦▪▫◆◇▶▷■□※★☆♥♡♠♣\\\"'“”‘’「」『』＂＇`*#><\\[\\]{}|~]+$"
              },
              "evidenceRefs": {
                "description": "변경 파일 경로, 식별자 또는 데이터 리터럴처럼 선택된 입력 근거에서 그대로 확인되는 참조",
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[^\\r\\n\\\"'“”‘’「」『』＂＇`]+$"
                }
              }
            }
          }
        },
        "targetIds": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80,
            "pattern": "^[A-Za-z0-9가-힣_./\\\\:#$=@<>~\\[\\]-]+$"
          }
        },
        "targetNames": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "pattern": "^(?!\\s*(?:[-*#]|[0-9]+[.)]))(?!.*[.,!?;:。，！？]$)[^\\r\\n\\u005c:;：；·ㆍ‧∙⋅○●•◦▪▫◆◇▶▷■□※★☆♥♡♠♣\\\"'“”‘’「」『』＂＇`*#><\\[\\]{}|~]+$"
          }
        },
        "preconditions": {
          "description": "테스트 실행에 실제로 필요한 0개 이상 5개 이하의 준비 조건",
          "type": "array",
          "minItems": 0,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 8,
            "maxLength": 160,
            "pattern": "^(?!\\s*(?:[-*#]|[0-9]+[.)]))(?=[^\\r\\n]*다$)[^\\r\\n\\u005c:;：；·ㆍ‧∙⋅○●•◦▪▫◆◇▶▷■□※★☆♥♡♠♣\\\"'“”‘’「」『』＂＇`*#><\\[\\]{}|~]+$"
          }
        },
        "notes": {
          "description": "모든 시나리오 결과를 종합해 변경 범위가 정상인지 판단하는 사용자용 한 문장",
          "type": "string",
          "minLength": 8,
          "maxLength": 200,
          "pattern": "^(?!\\s*(?:[-*#]|[0-9]+[.)]))(?=[^\\r\\n]*다$)[^\\r\\n\\u005c:;：；·ㆍ‧∙⋅○●•◦▪▫◆◇▶▷■□※★☆♥♡♠♣\\\"'“”‘’「」『』＂＇`*#><\\[\\]{}|~]+$"
        }
      }
    },
    "testResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processingDetails", "resultChecks"],
      "properties": {
        "processingDetails": {
          "description": "파일 목록이 아닌 핵심 변경 주제 1개 이상 5개 이하",
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "detail"],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 3,
                "maxLength": 80,
                "pattern": "^(?!\\s*(?:[-*#]|[0-9]+[.)]))(?!.*[.,!?;:。，！？]$)[^\\r\\n\\u005c:;：；·ㆍ‧∙⋅○●•◦▪▫◆◇▶▷■□※★☆♥♡♠♣\\\"'“”‘’「」『』＂＇`*#><\\[\\]{}|~]+$"
              },
              "detail": {
                "type": "string",
                "minLength": 6,
                "maxLength": 160,
                "pattern": "^(?!\\s*(?:[-*#]|[0-9]+[.)]))(?!.*[.,!?;:。，！？]$)[^\\r\\n\\u005c:;：；·ㆍ‧∙⋅○●•◦▪▫◆◇▶▷■□※★☆♥♡♠♣\\\"'“”‘’「」『』＂＇`*#><\\[\\]{}|~]+$"
              }
            }
          }
        },
        "resultChecks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 120,
            "pattern": "^(?!\\s*(?:[-*#]|[0-9]+[.)]))(?!.*[.,!?;:。，！？]$)[^\\r\\n\\u005c:;：；·ㆍ‧∙⋅○●•◦▪▫◆◇▶▷■□※★☆♥♡♠♣\\\"'“”‘’「」『』＂＇`*#><\\[\\]{}|~]+$"
          }
        }
      }
    }
  }
}
